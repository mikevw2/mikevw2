# Copy to .env and fill in. Never commit .env.

# Anthropic Console -> API Keys (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Shopify admin -> Settings -> Apps and sales channels -> Develop apps -> Create app. Domain is the *.myshopify.com host.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Admin API access token from that custom app; scopes: write_content write_products write_online_store_pages read_orders
SHOPIFY_ADMIN_TOKEN=

# Pinterest developer portal (https://developers.pinterest.com/apps/) -> your app -> App id / App secret
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Produced by the OAuth flow in src/clients/pinterest.ts (scopes boards:read pins:read pins:write user_accounts:read). Standard access needs an OAuth demo video.
PINTEREST_ACCESS_TOKEN=
# Redirect URI registered on the Pinterest app (local-only during the OAuth demo)
PINTEREST_REDIRECT_URI=http://localhost:3999/oauth/pinterest/callback

# DataForSEO dashboard -> API Access (https://app.dataforseo.com/api-access); pay-as-you-go from a $50 top-up
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Cloud -> IAM -> Service Accounts -> create key (JSON). Paste the whole JSON on one line, or a path to the file.
# Then add the service-account email as a user on the property in Search Console.
GSC_SERVICE_ACCOUNT_JSON=
# The Search Console property, e.g. sc-domain:example.com or https://example.com/
GSC_SITE_URL=

# Supabase -> Project Settings -> Database -> Connection string (URI), or any Postgres 14+
DATABASE_URL=postgres://user:pass@localhost:5432/store_ops

# Local approval UI port (binds to 127.0.0.1 only)
APPROVAL_UI_PORT=3999

# IANA timezone used for pin slots and cron maths
STORE_TIMEZONE=America/Boise
# Optional: public base URL of the storefront for building page links
STORE_PUBLIC_URL=https://example.com
