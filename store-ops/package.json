{
  "name": "store-ops",
  "version": "0.1.0",
  "private": true,
  "description": "AI-run SEO + Pinterest content pipeline for a small Shopify store. Drafts everything, publishes only approved rows, caps enforced in code.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "db:migrate": "tsx scripts/migrate.ts",
    "job:drafter": "tsx src/jobs/drafter.ts",
    "job:pin-factory": "tsx src/jobs/pinFactoryJob.ts",
    "job:poster": "tsx src/jobs/poster.ts",
    "job:weekly-report": "tsx src/jobs/weeklyReport.ts",
    "approval-ui": "tsx src/approval-ui/server.ts",
    "render:sample": "tsx scripts/render-sample-pin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "playwright": "1.56.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
